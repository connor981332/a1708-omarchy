pkgname=tb-ar-shim-dkms
pkgver=1.0.0
pkgrel=1
pkgdesc='Apple Alpine Ridge Thunderbolt suspend/resume fix'
arch=('x86_64')
options=('!debug')
url='https://github.com/orospakr/linux-apple-alpine-ridge-suspend'
license=('GPL-2.0-only')
depends=('dkms')
_commit=155ffe3a4a963bc8d84df72fa53f14eb16ea9a60
source=("thunderbolt-$_commit.tar.gz::https://codeload.github.com/orospakr/linux-apple-alpine-ridge-suspend/tar.gz/$_commit")
sha256sums=('9e97c8e4fd78bcd2a40dcb3665438b50289849182962e4646ec52eec3720a73e')
package() {
  local upstream="$srcdir/linux-apple-alpine-ridge-suspend-$_commit"
  local dest="$pkgdir/usr/src/tb-ar-shim-$pkgver"
  install -dm755 "$dest"
  install -m644 "$upstream"/module/{tb_ar_shim.c,Makefile,dkms.conf} "$dest/"
  install -Dm644 "$upstream/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
